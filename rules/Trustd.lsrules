{
  "description": "Certificate validation\n  https://support.apple.com/en-us/101555",
  "name": "Apple Trustd. Certificate validation",
  "rules": [
    {
      "action": "allow",
      "notes": "",
      "ports": "80",
      "process": "identifier.APPLE/com.apple.trustd",
      "remote-hosts": [
        "certs.apple.com",
        "crl.apple.com",
        "ocsp.apple.com"
      ]
    },
    {
      "action": "allow",
      "notes": "",
      "ports": "443",
      "process": "identifier.APPLE/com.apple.trustd",
      "remote-hosts": [
        "certs.apple.com",
        "valid.apple.com",
        "ocsp2.apple.com"
      ]
    },
    {
      "action": "allow",
      "notes": "",
      "ports": "80",
      "process": "identifier.APPLE/com.apple.trustd",
      "remote-hosts": [
        "crl3.digicert.com",
        "crl4.digicert.com",
        "ocsp.digicert.com",
        "ocsp.digicert.cn"
      ]
    }
  ]
}
