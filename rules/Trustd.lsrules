{
  "description": "",
  "name": "Trustd",
  "rules": [
    {
      "action": "allow",
      "notes": "",
      "ports": "80, 443",
      "priority": "high",
      "process": "identifier.APPLE/com.apple.trustd",
      "remote-hosts": [
        "certs.apple.com",
        "ocsp2.apple.com"
      ]
    },
