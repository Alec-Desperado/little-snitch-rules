{
  "description": "Apple iCloud.\n  Refer to https://support.apple.com/en-us/101555",
  "name": "Apple iCloud",
  "rules": [
    {
      "action": "allow",
      "notes": "Allow outgoing.\n  iCloud services",
      "ports": "443",
      "process": "appGroup.macOS",
      "protocol": "tcp",
      "remote-domains": [
        "apple-cloudkit.com"
      ]
    },
    {
